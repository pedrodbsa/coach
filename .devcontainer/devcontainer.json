{
  "name": "Coach",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--name",
    "vscode-coach-${devcontainerId}",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "remoteUser": "node",
  "mounts": [
    "source=coach-claude-config,target=/home/node/.claude,type=volume",
    "source=coach-codex-config,target=/home/node/.codex,type=volume",
    "source=coach-garminconnect-config,target=/home/node/.garminconnect,type=volume",
    "source=coach-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "GARMIN_EMAIL_FILE": "${containerWorkspaceFolder}/secrets/garmin_email",
    "GARMIN_PASSWORD_FILE": "${containerWorkspaceFolder}/secrets/garmin_password"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "openai.chatgpt",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }  
}